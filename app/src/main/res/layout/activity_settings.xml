<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="@string/settings_title"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/settings_feedback"
                android:textStyle="bold"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_haptics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_haptics" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_sounds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_sounds" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/setting_theme"
                android:textStyle="bold"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinner_theme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/setting_typing"
                android:textStyle="bold"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_suggestions" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_autocap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_autocap" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_learning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_learning" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="4dp"
                android:text="@string/setting_privacy"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="@string/setting_privacy_learn" />

            <Button
                android:id="@+id/btn_clear_learning"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_privacy_clear" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/setting_clipboard"
                android:textStyle="bold"
                android:textSize="16sp" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_clipboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_clipboard_desc" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="@string/setting_clipboard_hours" />

            <Spinner
                android:id="@+id/spinner_clipboard_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>