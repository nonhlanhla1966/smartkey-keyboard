    <string name="main_subtitle">A fast, private keyboard that lives entirely on your phone.</string>
    <string name="btn_enable_keyboard">Enable SmartKey Keyboard</string>
    <string name="btn_open_settings">Open keyboard settings</string>
    <string name="main_how_header">How to enable</string>
    <string name="main_ime_status_checking">Checking Android keyboard registration…</string>
    <string name="main_ime_status_checking_body">This updates automatically.</string>
    <string name="main_ime_status_enabled">SmartKey Keyboard is registered and enabled ✓</string>
    <string name="main_ime_status_enabled_body">Android knows SmartKey as an input method and it is enabled. Tap a text field, and if another keyboard opens, use the keyboard switcher in the status bar.</string>
    <string name="main_ime_status_registered">SmartKey Keyboard is registered but not enabled</string>
    <string name="main_ime_status_registered_body">Android recognizes SmartKey as an input method. Tap \u201cEnable SmartKey Keyboard\u201d below, then switch the SmartKey toggle ON (if the list shows it, tap it and confirm). If the toggle cannot be found, your device hides it under \u201cManage keyboards\u201d or \u201cAvailable keyboards\u201d.</string>
    <string name="main_ime_status_not_registered">SmartKey Keyboard is NOT registered with Android</string>
    <string name="main_ime_status_not_registered_body">Android did not find the SmartKey input method service. Reinstall the APK (the latest version fixes the IME registration) and reopen this screen. If it still says this, uninstall, restart the phone, and install again.</string>
    <string name="main_settings_unavailable">Could not open keyboard settings. Open Android Settings → System → Languages &amp; input manually.</string>
    <string name="main_privacy_header">Your privacy</string>
    <string name="main_privacy_body">SmartKey Keyboard works completely offline. It has no internet permission, shows no ads, does not track you, and never stores password contents. Typing suggestions, clipboard history, themes and settings all stay on this device.</string>
